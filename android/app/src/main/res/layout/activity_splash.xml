<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="center"
        android:id="@+id/glow"
        android:background="@drawable/splash_glow"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:alpha="0.7"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/snakeArt"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginBottom="36dp"
        android:src="@drawable/splash_snakes"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/tongue"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:layout_marginTop="28dp"
        android:src="@drawable/ic_snake_tongue"
        android:contentDescription="@null"
        android:alpha="0"
        android:translationY="-12dp"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/titleBlock"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="72dp"
        android:paddingHorizontal="24dp">
        <TextView
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:id="@+id/titleFlicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLICKER"
            android:alpha="0"
            android:letterSpacing="0.12"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:id="@+id/titleVpn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="VPN"
            android:alpha="0"
            android:letterSpacing="0.35"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/muted"
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="быстрый · тихий · свой"
            android:alpha="0"/>
    </LinearLayout>
    <View
        android:id="@+id/shimmer"
        android:background="@drawable/shimmer_band"
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:alpha="0.35"
        android:translationX="-120dp"/>
</FrameLayout>
